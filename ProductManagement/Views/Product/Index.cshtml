@model List<ProductManagement.Models.Product>

@{
    ViewData["Title"] = "Products";
}

<div class="container">
    <div class="page-header">
        <div>
            <h1>Product Management</h1>
            <p>Simple Product Management System</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">+ Add Product</a>
    </div>

    <form asp-action="Index" method="get" class="search-box">
        <input type="text" name="search" value="@ViewBag.Search"
               placeholder="Search by product name or category" />
        <button type="submit" class="btn btn-primary">Search</button>
        <a asp-action="Index" class="btn btn-secondary">Clear</a>
    </form>

    <div class="table-container">
        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Product</th>
                    <th>Category</th>
                    <th>Price</th>
                    <th>Quantity</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Count == 0)
            {
                <tr>
                    <td colspan="7" class="no-data">No products found.</td>
                </tr>
            }
            else
            {
                foreach (var product in Model)
                {
                    <tr>
                        <td>@product.Id</td>
                        <td><strong>@product.Name</strong></td>
                        <td>@product.Category</td>
                        <td>₹ @product.Price.ToString("0.00")</td>
                        <td>@product.Quantity</td>
                        <td>
                            @if (product.Quantity == 0)
                            {
                                <span class="status out">Out of Stock</span>
                            }
                            else if (product.Quantity <= 5)
                            {
                                <span class="status low">Low Stock</span>
                            }
                            else
                            {
                                <span class="status available">Available</span>
                            }
                        </td>
                        <td class="actions">
                            <a asp-action="Edit" asp-route-id="@product.Id"
                               class="btn btn-edit">Edit</a>

                            <form asp-action="Delete" asp-route-id="@product.Id"
                                  method="post" class="delete-form">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-delete"
                                        onclick="return confirmDelete();">
                                    Delete
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>
